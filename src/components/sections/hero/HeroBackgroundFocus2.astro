---
// Hero section with background image and overlay text
import type { CommonSection } from '@/src/types/pageBuilder';
import { getAssetUrlById } from '@/src/utils/image';

const { data } = Astro.props as CommonSection;
const backgroundUrl = getAssetUrlById(data?.cover?.[0]?.id);
---

<section class="relative">
  <img
    src={backgroundUrl}
    alt="Background image"
    class="absolute inset-0 size-full object-cover"
  />

  <div
    class="relative z-[2] flex flex-col items-center gap-1 py-40 text-center md:py-[100px] lg:gap-2 lg:py-[120px] 2xl:gap-4 2xl:py-[140px] 3xl:py-40"
    style="background: linear-gradient(0deg, rgba(0, 0, 0, 0.50) 0%, rgba(0, 0, 0, 0.50) 100%)"
  >
    <div class="container">
      {/* subtitle */}
      {data?.blurb && (
        <div
          class="text-base font-normal text-gray-200 md:text-lg lg:text-xl"
          set:html={data?.blurb}
        />
      )}
      
      {/* title */}
      {data?.title && (
        <h1 class="text-[28px] font-bold !leading-[1.5] text-white md:text-[40px] lg:text-[44px] 2xl:text-[48px] 3xl:text-[60px] 4xl:text-[72px]">
          {data?.title}
        </h1>
      )}
    </div>
  </div>
</section>
