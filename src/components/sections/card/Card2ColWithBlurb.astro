---
// 2-column card grid with content blocks
import type { CommonSection } from '@/src/types/pageBuilder';

const { data, dataDetail } = Astro.props as CommonSection;
const hasContent = dataDetail?.functionalities;

if (!hasContent || hasContent.length === 0) {
  return null;
}
---

<section class="py-8 lg:py-12 xl:py-[60px] 2xl:py-[80px] 3xl:py-[100px] 4xl:py-[120px]">
  <div class="container space-y-4 md:space-y-6 lg:space-y-8 xl:space-y-10 2xl:space-y-14 3xl:space-y-[60px]">
    <div class="space-y-1">
      <div class="section-sub-title">{data?.subtitle}</div>

      {data?.title && (
        <h2
          class="section-title mt-1"
          set:html={data?.title}
        />
      )}
    </div>

    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:gap-5 xl:gap-6 2xl:gap-8 3xl:gap-10">
      {dataDetail?.functionalities?.map((item: any, index: number) => {
        const isOdd = dataDetail?.functionalities?.length % 2 !== 0;
        return (
          <div
            key={index}
            class={`${isOdd ? 'last:col-span-full' : ''} group flex flex-col gap-3 rounded-[6px] bg-primary-50 p-5 transition-colors duration-200 *:transition-colors *:duration-200 hover:bg-primary-600 md:p-6 lg:p-7 xl:gap-5 xl:p-8 2xl:gap-6 2xl:p-9 3xl:p-10`}
          >
            <div
              class="section-content font-normal text-[#09090B] group-hover:text-[#F4F4F5]"
              set:html={item?.text}
            />
          </div>
        );
      })}
    </div>
  </div>
</section>
