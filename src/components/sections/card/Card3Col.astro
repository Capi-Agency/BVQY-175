---
// 3-column card grid with icons and descriptions
import type { CommonSection } from '@/src/types/pageBuilder';
import { getAssetUrlById } from '@/src/utils/image';

const { data } = Astro.props as CommonSection;
---

<section class="bg-primary-50 py-8 md:py-10 lg:py-12 xl:py-16 2xl:py-[72px] 3xl:py-[80px] 4xl:py-[100px]">
  <div class="container">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5 lg:gap-6 xl:gap-7 2xl:gap-8 3xl:gap-9 4xl:gap-10">
      <div>
        {data?.title && (
          <h2
            class="section-title font-bold text-primary-600"
            set:html={data?.title}
          />
        )}
      </div>

      {data?.buttons?.map((item: any, index: number) => (
        <div
          key={index}
          class="space-y-4 rounded-[6px] bg-white p-4 md:p-5 lg:space-y-5 lg:p-6 xl:p-7 2xl:space-y-6 2xl:p-8 3xl:p-9 4xl:p-10"
        >
          <div class="flex items-center gap-4 lg:gap-5 2xl:gap-6">
            <div class="relative size-8 md:size-9 xl:size-10 2xl:size-11 3xl:size-12">
              <img src={getAssetUrlById(item?.icon?.id)} alt="icon" class="size-full object-contain" />
            </div>
            <div class="text-lg font-bold text-[#09090B] md:text-xl lg:text-2xl xl:text-[28px] 2xl:text-[32px] 3xl:text-[36px] 4xl:text-[40px]">
              {item?.title}
            </div>
          </div>

          <div
            class="text-sm font-medium text-[#09090B] md:text-base xl:text-lg 3xl:text-xl [&_li]:mt-1 [&_ul]:ml-1 [&_ul_ul]:ml-4 [&_ul]:list-inside [&_ul]:list-disc"
            set:html={item?.blurb}
          />
        </div>
      ))}
    </div>
  </div>
</section>
